{
  "title": "ReleasePilot Service Overview",
  "schemaVersion": 39,
  "panels": [
    { "title": "Request rate", "type": "timeseries", "targets": [{ "expr": "sum(rate(releasepilot_http_requests_total[5m]))" }] },
    { "title": "p95 latency", "type": "timeseries", "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(releasepilot_http_request_duration_seconds_bucket[5m])) by (le))" }] },
    { "title": "5xx error rate", "type": "stat", "targets": [{ "expr": "sum(rate(releasepilot_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(releasepilot_http_requests_total[5m]))" }] }
  ]
}
